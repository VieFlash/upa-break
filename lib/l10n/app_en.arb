  "exNeckTiltName": "Neck tilt",
  "exNeckTiltSteps": "Sit up straight, relax your shoulders.\nTilt your right ear toward your right shoulder, hold 10 seconds.\nBack to center, tilt to the left, hold 10 seconds.\nBreathe evenly, go slowly, never into pain.",
  "exChinTuckName": "Chin tuck",
  "exChinTuckSteps": "Sit up straight, eyes looking forward.\nDraw your chin straight back, like making a double chin.\nHold 5 seconds, then relax.\nRepeat about 5 times.",
  "exNeckTurnName": "Neck turn",
  "exNeckTurnSteps": "Slowly turn your head to the right, hold 5 seconds.\nBack to center.\nTurn to the left, hold 5 seconds.\nOnly turn left and right, no full circles.",
  "exShoulderRollName": "Shoulder rolls",
  "exShoulderRollSteps": "Shrug both shoulders up toward your ears.\nMove them back, then down.\nRoll backward 5 times.\nSwitch direction, roll forward 5 times.",
  "exShoulderShrugName": "Shrug and release",
  "exShoulderShrugSteps": "Breathe in, shrug both shoulders up high.\nHold 3 seconds.\nBreathe out, let your shoulders drop and relax.\nRepeat about 6 times.",
  "exChestOpenName": "Chest opener",
  "exChestOpenSteps": "Clasp your hands behind your back.\nSqueeze your shoulder blades together.\nLift your chest gently, look slightly up.\nHold and breathe evenly.",
  "exOverheadReachName": "Overhead reach",
  "exOverheadReachSteps": "Interlace your fingers, palms facing up.\nReach straight up over your head.\nLengthen your spine, hold 10 seconds.\nRelax, then repeat.",
  "exSideBendName": "Side bend",
  "exSideBendSteps": "Raise your right arm up high.\nLean to the left, hold 10 seconds.\nSwitch arms, lean to the right, hold 10 seconds.\nKeep your hips on the chair.",
  "exSeatedTwistName": "Seated twist",
  "exSeatedTwistSteps": "Sit up straight, feet flat on the floor.\nTwist to the right, left hand on your right knee.\nHold 10 seconds, breathing evenly.\nSwitch sides.",
  "exCatCowName": "Seated cat-cow",
  "exCatCowSteps": "Sit at the edge of your chair, hands on your thighs.\nBreathe in: open your chest, look up.\nBreathe out: round your back, drop your head.\nRepeat slowly, like a cat.",
  "exWristFlexName": "Wrist stretch (palm up)",
  "exWristFlexSteps": "Extend your right arm, palm facing up.\nWith your left hand, gently pull your fingers down.\nHold 10 seconds, then switch hands.\nPull gently, never hard.",
  "exWristExtName": "Wrist stretch (palm down)",
  "exWristExtSteps": "Extend your arm, palm facing down.\nWith the other hand, gently press the back of your hand down.\nHold 10 seconds, then switch hands.\nRelax your fingers.",
  "exFistSpreadName": "Fist and spread",
  "exFistSpreadSteps": "Make tight fists with both hands.\nSpread your fingers as wide as you can.\nRepeat about 10 times.\nRoll your wrists a few times each way.",
  "exEye2020Name": "Look far for 20 seconds",
  "exEye2020Steps": "Look away from the screen.\nFocus on something about 6 meters away.\nBlink slowly a few times.\nRelax your face.",
  "exEyePalmingName": "Palming",
  "exEyePalmingSteps": "Rub your palms together until warm.\nCup them gently over your eyes, without pressing.\nBreathe slowly in the dark.\nRemove your hands, open your eyes slowly.",
  "exCalfRaiseName": "Calf raises",
  "exCalfRaiseSteps": "Stand up, lightly holding the desk.\nRise onto your toes, hold 2 seconds.\nLower your heels slowly.\nRepeat about 12 times.",
  "exAnkleCircleName": "Ankle circles",
  "exAnkleCircleSteps": "Extend your right leg, lift it slightly off the floor.\nCircle your ankle 5 times each way.\nSwitch to your left leg.\nKeep your back straight.",
  "exFigureFourName": "Figure-four stretch",
  "exFigureFourSteps": "Rest your right ankle on your left knee.\nKeep your back straight, lean forward slightly.\nHold about 15 seconds.\nSwitch legs."
}
