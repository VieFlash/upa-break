  "exNeckTiltName": "Nghiêng cổ",
  "exNeckTiltSteps": "Ngồi thẳng, thả lỏng hai vai.\nNghiêng tai phải về phía vai phải, giữ 10 giây.\nVề giữa, nghiêng sang trái, giữ 10 giây.\nThở đều, làm chậm, không gây đau.",
  "exChinTuckName": "Thu cằm",
  "exChinTuckSteps": "Ngồi thẳng, mắt nhìn về phía trước.\nKéo cằm lùi ra sau như đang tạo cằm đôi.\nGiữ 5 giây rồi thả lỏng.\nLặp lại khoảng 5 lần.",
  "exNeckTurnName": "Quay cổ trái phải",
  "exNeckTurnSteps": "Từ từ quay đầu sang phải, giữ 5 giây.\nQuay về giữa.\nQuay sang trái, giữ 5 giây.\nChỉ quay trái phải, không xoay tròn cả vòng.",
  "exShoulderRollName": "Xoay vai",
  "exShoulderRollSteps": "Nhún hai vai lên gần tai.\nĐưa vai ra sau rồi hạ xuống.\nXoay 5 vòng ra sau.\nĐổi chiều, xoay 5 vòng ra trước.",
  "exShoulderShrugName": "Nhún vai thả lỏng",
  "exShoulderShrugSteps": "Hít vào, nhún hai vai lên cao.\nGiữ 3 giây.\nThở ra, thả vai rơi xuống thật thả lỏng.\nLặp lại khoảng 6 lần.",
  "exChestOpenName": "Mở ngực",
  "exChestOpenSteps": "Đan hai bàn tay ra sau lưng.\nKéo hai bả vai lại gần nhau.\nƯỡn nhẹ ngực, mắt nhìn hơi lên.\nGiữ và thở đều.",
  "exOverheadReachName": "Vươn người lên cao",
  "exOverheadReachSteps": "Đan hai tay, lật lòng bàn tay lên trên.\nVươn thẳng tay qua đầu.\nKéo dài cột sống, giữ 10 giây.\nThả lỏng rồi lặp lại.",
  "exSideBendName": "Nghiêng người",
  "exSideBendSteps": "Giơ tay phải lên cao.\nNghiêng người sang trái, giữ 10 giây.\nĐổi tay, nghiêng sang phải, giữ 10 giây.\nGiữ mông luôn chạm ghế.",
  "exSeatedTwistName": "Vặn mình trên ghế",
  "exSeatedTwistSteps": "Ngồi thẳng, hai bàn chân đặt trên sàn.\nXoay thân sang phải, tay trái đặt lên gối phải.\nGiữ 10 giây, thở đều.\nĐổi bên.",
  "exCatCowName": "Cong lưng kiểu mèo",
  "exCatCowSteps": "Ngồi mép ghế, hai tay đặt lên đùi.\nHít vào: ưỡn ngực, nhìn lên.\nThở ra: cong tròn lưng, cúi đầu.\nLặp lại thật chậm, như một chú mèo.",
  "exWristFlexName": "Giãn cổ tay (ngửa)",
  "exWristFlexSteps": "Duỗi tay phải ra trước, lòng bàn tay ngửa.\nTay trái kéo nhẹ các ngón tay xuống.\nGiữ 10 giây rồi đổi tay.\nKéo nhẹ nhàng, không kéo mạnh.",
  "exWristExtName": "Giãn cổ tay (úp)",
  "exWristExtSteps": "Duỗi tay ra trước, lòng bàn tay úp.\nTay kia ấn nhẹ mu bàn tay xuống.\nGiữ 10 giây rồi đổi tay.\nThả lỏng các ngón tay.",
  "exFistSpreadName": "Nắm – xòe tay",
  "exFistSpreadSteps": "Nắm chặt hai bàn tay.\nXòe rộng hết cỡ các ngón.\nLặp lại khoảng 10 lần.\nXoay cổ tay vài vòng mỗi chiều.",
  "exEye2020Name": "Nhìn xa 20 giây",
  "exEye2020Steps": "Rời mắt khỏi màn hình.\nNhìn một vật ở xa khoảng 6 mét.\nChớp mắt chậm vài lần.\nThả lỏng cơ mặt.",
  "exEyePalmingName": "Úp tay nghỉ mắt",
  "exEyePalmingSteps": "Xoa hai lòng bàn tay cho ấm.\nÚp nhẹ lên mắt, không ấn vào mắt.\nHít thở chậm trong bóng tối.\nBỏ tay ra, mở mắt từ từ.",
  "exCalfRaiseName": "Kiễng gót",
  "exCalfRaiseSteps": "Đứng dậy, vịn nhẹ vào bàn.\nKiễng gót lên cao, giữ 2 giây.\nHạ gót xuống từ từ.\nLặp lại khoảng 12 lần.",
  "exAnkleCircleName": "Xoay cổ chân",
  "exAnkleCircleSteps": "Duỗi chân phải, nhấc nhẹ khỏi sàn.\nXoay cổ chân 5 vòng mỗi chiều.\nĐổi sang chân trái.\nNgồi thẳng lưng khi làm.",
  "exFigureFourName": "Giãn hông số 4",
  "exFigureFourSteps": "Gác mắt cá chân phải lên gối trái.\nLưng thẳng, nghiêng nhẹ người về trước.\nGiữ khoảng 15 giây.\nĐổi chân."
}
